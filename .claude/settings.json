{
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run tle:*)",
      "Bash(uv sync:*)",
      "Bash(uv run python tools/harness_check.py:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3 tools/post_edit_hook.py" }
        ]
      }
    ]
  }
}

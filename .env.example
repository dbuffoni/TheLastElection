# Copy to .env (kept local, ignored by git) and fill in. Used by: tle run --engines config/engines.openrouter.toml
OPENROUTER_API_KEY=
# S1: Jev (decision model, pure classifier); S2: a small open chat model
TLE_S1_MODEL=typesafe/jev-1.14
TLE_S1_URL=https://openrouter.ai/api/alpha/decisions
# S2: the narrator (any chat model on OpenRouter; pick one and check its id on openrouter.ai/models)
TLE_S2_MODEL=meta-llama/llama-3.1-8b-instruct
TLE_S2_URL=https://openrouter.ai/api/v1

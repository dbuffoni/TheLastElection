# Copy to .env (kept local, ignored by git) and fill in. Used by: tle run --engines config/engines.openrouter.toml
OPENROUTER_API_KEY=
# S1: small open classifier (for Jev use config/engines.openrouter-jev.toml with typesafe/jev-1.14 and https://openrouter.ai/api/alpha/decisions)
TLE_S1_MODEL=mistralai/ministral-8b-2512
TLE_S1_URL=https://openrouter.ai/api/v1
# S2: the narrator (any chat model on OpenRouter; pick one and check its id on openrouter.ai/models)
TLE_S2_MODEL=mistralai/mistral-nemo
TLE_S2_URL=https://openrouter.ai/api/v1
